# Resend API Configuration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_RECEIVER_EMAIL=sunilparajuli2002@gmail.com
NEXT_PUBLIC_SITE_URL=https://sunilparajuli.com

# Blog: server-only secrets. Never prefix these with NEXT_PUBLIC_.
DATABASE_URL=postgres://APP_USER:APP_PASSWORD@HOST:PORT/sunil_blog?sslmode=verify-full
# Paste Aiven's CA PEM as a quoted multiline value, or use literal \n separators.
DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nYOUR_AIVEN_CA\n-----END CERTIFICATE-----"
# Generate with: openssl rand -hex 32. Remove after first admin password setup.
ADMIN_SETUP_TOKEN=replace-with-a-long-random-secret
